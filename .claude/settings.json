{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.claude/hooks/memory_ledger_hooks.py session-start",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.claude/hooks/method_guard.py session-start",
            "timeout": 10
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.claude/hooks/method_guard.py user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.claude/hooks/method_guard.py pre-tool-use",
            "timeout": 20
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Agent|Task"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.claude/hooks/method_guard.py post-tool-use",
            "timeout": 20
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.claude/hooks/method_guard.py subagent-stop",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.claude/hooks/method_guard.py stop",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.claude/hooks/memory_ledger_hooks.py pre-compact",
            "timeout": 30
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.claude/hooks/memory_ledger_hooks.py session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
