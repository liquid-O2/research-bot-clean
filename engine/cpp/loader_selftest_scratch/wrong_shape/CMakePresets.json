{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "dev (-O0 -g, no sanitizers)",
      "binaryDir": "/workspace/artifacts/cache/cpp/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O0 -g"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "asan (-O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all)",
      "binaryDir": "/workspace/artifacts/cache/cpp/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release (-O2 -g -fno-omit-frame-pointer -ffp-contract=off)",
      "binaryDir": "/workspace/artifacts/cache/cpp/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-O2 -g -fno-omit-frame-pointer -ffp-contract=off",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": ""
      }
    },
    {
      "name": "mutant",
      "inherits": "base",
      "displayName": "mutant (red-ledger mutation runs; same flags as dev)",
      "binaryDir": "/workspace/artifacts/cache/cpp/mutant",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O0 -g"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "release", "configurePreset": "release" },
    { "name": "mutant", "configurePreset": "mutant" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "mutant", "configurePreset": "mutant", "output": { "outputOnFailure": true } }
  ]
}
