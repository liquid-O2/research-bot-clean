{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.codex/hooks/optmem_lifecycle.py session-start",
            "timeout": 30,
            "additionalContextLimit": 12000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.codex/hooks/optmem_lifecycle.py pre-compact",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.codex/hooks/optmem_lifecycle.py post-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/algo/.local/share/fnm/node-versions/v24.19.0/installation/bin/node' '/workspace/vendor/agent-sources/unlazy/754d9a68109e39b836cc72a39fb9a823f9d6b613/scripts/stop-hook.mjs' --unlazy",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
