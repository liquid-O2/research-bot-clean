{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.codex/hooks/memory_ledger_hooks.py session-start",
            "timeout": 20,
            "additionalContextLimit": 12000
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.codex/hooks/method_guard.py session-start",
            "timeout": 10,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.codex/hooks/method_guard.py user-prompt-submit",
            "timeout": 10,
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.codex/hooks/method_guard.py pre-tool-use",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.codex/hooks/method_guard.py subagent-start",
            "timeout": 10,
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.codex/hooks/method_guard.py subagent-stop",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.codex/hooks/memory_ledger_hooks.py pre-compact",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.codex/hooks/memory_ledger_hooks.py session-end",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /workspace/.codex/hooks/method_guard.py stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
